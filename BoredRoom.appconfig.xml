<?xml version="1.0" encoding="UTF-8"?>
<!-- AppConfig Community spec for Bored Room. Consoles that import a spec file: Workspace ONE UEM,
     Ivanti EPMM, IBM MaaS360, SOTI, ManageEngine. Jamf, Intune, Mosyle and Iru take the <dict> as a
     plist instead; see setup-mdm.html. Every key is optional. A managed key overrides the on-device value and locks it in Settings.
     With serviceAccountKey set, no sign-in happens on the iPad at all. -->
<managedAppConfiguration>
  <version>1</version>
  <bundleId>com.dmarcantonio.RoomBoard</bundleId>
  <dict>
    <string keyName="roomName"/>
    <string keyName="calendarId"/>
    <string keyName="serviceAccountKey"/>
    <string keyName="background">
      <defaultValue><value>midnight</value></defaultValue>
      <constraint nullable="true">
        <values>
          <value>midnight</value>
          <value>slate</value>
          <value>ocean</value>
          <value>plum</value>
          <value>charcoal</value>
        </values>
      </constraint>
    </string>
    <string keyName="font">
      <defaultValue><value>classic</value></defaultValue>
      <constraint nullable="true">
        <values>
          <value>classic</value>
          <value>inter</value>
          <value>manrope</value>
          <value>publicsans</value>
          <value>sourcesans</value>
          <value>geist</value>
          <value>hanken</value>
          <value>archivo</value>
        </values>
      </constraint>
    </string>
    <string keyName="pin"/>
    <boolean keyName="allowBooking">
      <defaultValue><value>true</value></defaultValue>
    </boolean>
    <boolean keyName="showMeetingTitles">
      <defaultValue><value>true</value></defaultValue>
    </boolean>
    <boolean keyName="alwaysOn">
      <defaultValue><value>false</value></defaultValue>
    </boolean>
    <string keyName="activeDays">
      <defaultValue><value>Mon,Tue,Wed,Thu,Fri</value></defaultValue>
    </string>
    <string keyName="activeHours">
      <defaultValue><value>07:00-17:00</value></defaultValue>
    </string>
    <string keyName="backgroundImageURL"/>
    <integer keyName="backgroundDimming">
      <defaultValue><value>55</value></defaultValue>
      <constraint min="30" max="90" nullable="true"/>
    </integer>
  </dict>
  <presentation defaultLocale="en-US">
    <field keyName="roomName" type="input">
      <label><language value="en-US">Room name</language></label>
      <description><language value="en-US">Shown at the top of the board, e.g. "Boardroom".</language></description>
    </field>
    <field keyName="calendarId" type="input">
      <label><language value="en-US">Google calendar ID</language></label>
      <description><language value="en-US">The room resource's calendar ID, e.g. c_abc123@resource.calendar.google.com. Found in Google Admin console under Buildings and resources.</language></description>
    </field>
    <field keyName="serviceAccountKey" type="input">
      <label><language value="en-US">Service account key (JSON)</language></label>
      <description><language value="en-US">Contents of the service account's key file, raw JSON or base64. The iPad uses it to read the room with no sign-in. Share each room's calendar with the service account's email first.</language></description>
    </field>
    <field keyName="background" type="select">
      <label><language value="en-US">Background</language></label>
      <options>
        <option value="midnight"><language value="en-US">Midnight</language></option>
        <option value="slate"><language value="en-US">Slate</language></option>
        <option value="ocean"><language value="en-US">Ocean</language></option>
        <option value="plum"><language value="en-US">Plum</language></option>
        <option value="charcoal"><language value="en-US">Charcoal</language></option>
      </options>
    </field>
    <field keyName="font" type="select">
      <label><language value="en-US">Font</language></label>
      <options>
        <option value="classic"><language value="en-US">San Francisco</language></option>
        <option value="inter"><language value="en-US">Inter</language></option>
        <option value="manrope"><language value="en-US">Manrope</language></option>
        <option value="publicsans"><language value="en-US">Public Sans</language></option>
        <option value="sourcesans"><language value="en-US">Source Sans</language></option>
        <option value="geist"><language value="en-US">Geist</language></option>
        <option value="hanken"><language value="en-US">Hanken Grotesk</language></option>
        <option value="archivo"><language value="en-US">Archivo</language></option>
      </options>
    </field>
    <field keyName="pin" type="input">
      <label><language value="en-US">Settings PIN</language></label>
      <description><language value="en-US">4 digits. Needed to open Settings on the iPad.</language></description>
    </field>
    <field keyName="allowBooking" type="checkbox">
      <label><language value="en-US">Allow booking from the iPad</language></label>
    </field>
    <field keyName="showMeetingTitles" type="checkbox">
      <label><language value="en-US">Show meeting titles</language></label>
    </field>
    <field keyName="alwaysOn" type="checkbox">
      <label><language value="en-US">Always on</language></label>
      <description><language value="en-US">Keep the board lit around the clock. Off: the board goes dark outside the active days and hours and wakes for a minute when touched.</language></description>
    </field>
    <field keyName="activeDays" type="input">
      <label><language value="en-US">Active days</language></label>
      <description><language value="en-US">Comma-separated three-letter English day names, e.g. Mon,Tue,Wed,Thu,Fri.</language></description>
    </field>
    <field keyName="activeHours" type="input">
      <label><language value="en-US">Active hours</language></label>
      <description><language value="en-US">24-hour range, e.g. 07:00-17:00. 24:00 is allowed as the end. 15-minute steps.</language></description>
    </field>
    <field keyName="backgroundImageURL" type="input">
      <label><language value="en-US">Background image URL</language></label>
      <description><language value="en-US">https:// link to a JPEG, PNG or HEIC of 10 MB or less. Downloaded at most once a day; locks the Background section on the iPad.</language></description>
    </field>
    <field keyName="backgroundDimming" type="input">
      <label><language value="en-US">Photo dimming (%)</language></label>
      <description><language value="en-US">30 to 90. How much the photo is darkened behind the text. 55 is the default.</language></description>
    </field>
  </presentation>
</managedAppConfiguration>
